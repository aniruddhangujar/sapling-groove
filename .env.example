# Server-side AI Provider API Key (Ani Companion)
# Loaded server-side only in Vercel Serverless Function / Vite dev server middleware
GEMINI_API_KEY=

# Client-side Firebase Web Configuration (Safe for public browser bundle)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Optional: Community Support URL override (defaults to GitHub Sponsors if unset)
VITE_SUPPORT_URL=
